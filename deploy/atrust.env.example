# 复制为 atrust.env 后填写：cp atrust.env.example atrust.env && chmod 600 atrust.env
# 只有 atrust 容器读取这个文件。值不要加引号；密码里有空格也没关系。

ATRUST_PORTAL=https://vpnu.whut.edu.cn
ATRUST_USERNAME=
ATRUST_PASSWORD=
# 可选：开启了动态口令（TOTP）时填密钥
ATRUST_TOTP_KEY=
# 可选：绕过图形验证码。在自己电脑的浏览器里登录一次门户，F12 → Application → Cookies，
# 复制 tid 和 tid.sig 两个 Cookie 的值（不填的话首次登录可能需要用 VNC 手动输一次验证码）
ATRUST_COOKIE_TID=
ATRUST_COOKIE_SIG=
# 保活间隔（秒）
ATRUST_KEEPALIVE=200
# VNC 密码（VNC 端口只监听服务器本机，需要 ssh -L 转发才能连）
PASSWORD=change-me
