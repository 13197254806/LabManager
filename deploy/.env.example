# ==========================================================================
#  实验室平台 · 全部配置（只有这一个文件）
#
#  修改方法：vim ~/lab/deploy/.env（普通用户即可，不需要 sudo），保存后几秒内自动生效（只重启受影响的服务）。
#  查看是否生效：tail ~/lab/deploy/data/config-apply.log
#
#  注意：
#   - 这个文件里有密码，权限保持 600，不要提交到 git，也不要发给别人
#   - 值一般不需要加引号；如果值里有 $ 或 " #"（空格加井号），请用单引号括起来，如 WEBVPN_PASSWORD='a$b #c'
# ==========================================================================

# ---------------- 平台 ----------------
LAB_NAME=XX实验室
# 正式域名（需已备案并解析到本机；Caddy 自动申请 HTTPS 证书）
DOMAIN=www.zddlab.cn
# 平台对外地址：飞书登录回调、消息卡片里的链接都用它
BASE_URL=https://www.zddlab.cn
# 域名还不能用时（如备案中）的临时入口：取消注释，并把 BASE_URL 改成同一个地址。
# 走的是不加密的 HTTP，域名可用后请删掉并把 BASE_URL 改回 https://域名
# HTTP_SITE=http://<服务器公网IP>

# 随机长字符串，用于签名登录 Cookie（setup-server.sh 会自动生成）
SECRET_KEY=change-me

# ---------------- 飞书 ----------------
# 飞书开放平台 → 自建应用 → 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选：只允许该企业成员登录
FEISHU_TENANT_KEY=
# 可选：只对这些群（逗号分隔 chat_id）的新成员发欢迎卡片；留空 = 机器人所在的所有群
WELCOME_CHAT_IDS=

# ---------------- 预约规则 ----------------
MAX_RESERVATION_DAYS=14
MAX_ADVANCE_DAYS=30
REMINDER_HOUR=20
TZ_NAME=Asia/Shanghai
# 本地开发用的免密登录，线上必须是 0
DEV_LOGIN=0

# ---------------- 校园网（WebVPN 自动登录 + chisel 隧道） ----------------
# 公网服务器登录学校 WebVPN（支持 WebSocket），经它用 chisel 连到各 GPU 服务器。
# 云服务器只做管理（Agent 回连平台），不接管 GPU 的外网——GPU 上外网由同学各自挂代理。
# 启用 proxy + tunnel 服务；不需要校园网接入时删掉这一行
COMPOSE_PROFILES=campus

WEBVPN_PORTAL=https://webvpn.whut.edu.cn
# 统一身份认证账号（和 aTrust 相同）。遇到滑块验证码会自动识别，无需人工
WEBVPN_USER=
WEBVPN_PASSWORD=

# 家宽代理：学校 WebVPN 封了云服务器 IP，隧道必须经家宽出口访问。
# 填你机场/代理里【家宽(residential)节点】的 ss:// 链接（Shadowrocket 里「复制网址」）；
# 可填多个（逗号分隔），第一个作主用、不通自动切下一个。建议第一个填家宽节点。
# 含 $ 或空格的话整行用单引号括起来。改完保存会自动重建代理。
WEBVPN_PROXY_NODES=
# 隧道用的代理地址（指向下面的 proxy 服务，一般不用改）
WEBVPN_PROXY=http://proxy:7891

# chisel 认证口令：公网服务器和每台 GPU 的 chisel 共用，防止别人冒连。setup-server.sh 会自动生成
CHISEL_SECRET=
# GPU 上 chisel 监听的端口
CHISEL_PORT=9000
# 只允许 WebVPN 出口网段访问 GPU 上的 chisel 端口（防火墙放行用；一般不用改）
CHISEL_ALLOW=59.69.127.0/24
# 可选：GPU chisel 服务端公钥指纹，填了就固定校验、防中间人（见管理员手册）。默认不校验
CHISEL_FINGERPRINT=

# GPU 服务器列表：在平台「管理 → GPU 服务器」里添加即可，隧道会自动从平台读取，这里一般留空。
# TUNNEL_TARGETS 仅作兜底（平台数据库读不到时用）：名称=内网地址:chisel端口。
# TUNNEL_TARGETS=

# ---------------- 构建镜像用的国内源（留空则用官方源） ----------------
APT_MIRROR=mirrors.cloud.tencent.com
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
