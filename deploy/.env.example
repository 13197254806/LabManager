# 复制为 .env 后修改：cp .env.example .env && chmod 600 .env
# 注意：.env 里有密码，不要提交到 git，也不要发给别人

# ---------------- 平台 ----------------
# 域名（需解析到本服务器；Caddy 会自动申请 HTTPS 证书。国内服务器的域名需要已备案）
DOMAIN=www.zddlab.cn
BASE_URL=https://www.zddlab.cn
LAB_NAME=XX实验室

# 随机长字符串，用于签名登录 Cookie：python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# 飞书开放平台 → 自建应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
FEISHU_TENANT_KEY=
WELCOME_CHAT_IDS=

MAX_RESERVATION_DAYS=14
MAX_ADVANCE_DAYS=30
REMINDER_HOUR=20
TZ_NAME=Asia/Shanghai
DEV_LOGIN=0

# ---------------- 校园网（aTrust + 隧道） ----------------
# 启用 atrust 和 tunnel 两个服务；不需要时删掉这一行
COMPOSE_PROFILES=campus

# 校园网账号密码不放这里，放在 atrust.env（只有 atrust 容器能读到）
# 镜像下载慢时见 setup-server.sh（从 ModelScope 国内地址导入）
ATRUST_IMAGE=kenvix/docker-atrust-autologin:latest

# 要建立隧道的 GPU 服务器：名称=内网地址:SSH端口，名称与平台「管理 → GPU 服务器」里的名称一致
TUNNEL_TARGETS=gpu_01=192.168.247.150:22,gpu_02=192.168.247.151:22
# GPU 服务器经隧道上外网时，允许访问的端口
PROXY_ALLOWED_PORTS=80,443

# ---------------- 构建镜像用的国内源（留空则用官方源） ----------------
APT_MIRROR=mirrors.cloud.tencent.com
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
